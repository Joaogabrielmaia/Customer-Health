# Copie para .env e ajuste. Nenhum valor real é necessário: tudo roda local.
DATABASE_URL="postgresql://termometro:termometro@localhost:5440/termometro?schema=public"
# Segredo de assinatura da sessão (mínimo 32 caracteres). Gere um valor aleatório local.
AUTH_SECRET="troque-por-um-valor-aleatorio-com-32-caracteres-ou-mais"
# Data de referência dos dados sintéticos (o "hoje" do estudo). Fixa para resultados reproduzíveis.
REFERENCE_DATE="2026-10-15"
