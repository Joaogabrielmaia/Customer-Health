{
  "name": "termometro-customer-health",
  "version": "1.0.0",
  "private": true,
  "description": "Termômetro: painel de saúde de clientes (Customer Health) para o SaaS fictício Frota Leve.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test --grep-invert @screenshots",
    "screenshots": "playwright test --grep @screenshots",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed/index.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx scripts/seed/index.ts",
    "sensitivity": "tsx scripts/sensitivity.ts",
    "export:powerbi": "tsx scripts/export-powerbi.ts",
    "bench": "tsx scripts/bench.ts",
    "distribution": "tsx scripts/distribution.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.10.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.15.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.31",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9"
  }
}
